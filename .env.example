# Copy to .env (bin/setup.php does this on create-project, with generated
# passwords). .env is git-ignored: never commit real secrets.
#
# Values marked [docker] suit the included docker-compose stack; on a Linux
# or Windows server, set them to your own database, URL and mail.

# --- Environment -------------------------------------------------------------
# dev | test | live. Use "live" in production (caching, no debug output).
SS_ENVIRONMENT_TYPE="dev"
# Production: the site's URL, so links and emails are right behind proxies
# SS_BASE_URL="https://www.example.com"
# Site timezone (default America/Chicago, see app/_config.php)
# SS_TIMEZONE="America/Chicago"

# --- Database ----------------------------------------------------------------
SS_DATABASE_CLASS="MySQLDatabase"
SS_DATABASE_SERVER="db"                 # [docker] the "db" service; else e.g. localhost
SS_DATABASE_PORT="3306"
SS_DATABASE_NAME="silverwind"
SS_DATABASE_USERNAME="root"             # production: a dedicated user, not root
SS_DATABASE_PASSWORD=""

# --- CMS admin (created on the first db:build) --------------------------------
SS_DEFAULT_ADMIN_USERNAME="admin"
SS_DEFAULT_ADMIN_PASSWORD=""

# --- Email -------------------------------------------------------------------
MAILER_DSN="smtp://mailpit:1025"        # [docker] Mailpit, web UI on MAILPIT_PORT
# Production examples: smtp://user:pass@smtp.example.com:587 , sendmail://default

# --- Docker stack ([docker] only) --------------------------------------------
COMPOSE_PROJECT_NAME="silverwind"
WEB_PORT="8080"
MAILPIT_PORT="8025"
# Host user/group id, so files the container writes are yours (Linux: id -u / id -g)
DOCKER_UID="1000"
DOCKER_GID="1000"

# --- Optional ----------------------------------------------------------------
# Demo photos for tasks:seed-demo-site (free key: https://pixabay.com/api/docs/);
# placeholders without it
# PIXABAY_API_KEY=""

# Local module development: link vendor/antlion/* and themes/silverwind to
# your checkouts after composer install/update (bin/link-local-modules.php)
# ANTLION_MODULES_DIR="/home/you/projects/antlion-modules"

# Composer: read-only GitHub token to avoid API rate limits
# COMPOSER_AUTH={"github-oauth":{"github.com":"..."}}
