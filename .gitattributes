# Normalise line endings; keep LF in files read inside Linux containers or
# by tools that need it, so a Windows checkout still works in Docker.
* text=auto
*.sh text eol=lf
*.php text eol=lf
*.yml text eol=lf
*.ss text eol=lf
.env* text eol=lf
Dockerfile text eol=lf
*.patch text eol=lf -whitespace

*.png binary
*.jpg binary
*.ico binary
