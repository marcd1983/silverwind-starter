<?xml version="1.0"?>
<ruleset name="silverstripe-tailwind">
    <description>Coding standard for this project: PSR-12 with Silverstripe allowances</description>

    <file>app</file>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <!-- Warnings (e.g. long lines of copy in the seed task) are reported but don't fail CI -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="PSR12">
        <!-- Silverstripe's Page / PageController live in the global namespace -->
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <!-- Silverstripe naming: Page_Controller-style classes, template methods like Form() -->
        <exclude name="Squiz.Classes.ValidClassName.NotCamelCaps"/>
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="150"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
