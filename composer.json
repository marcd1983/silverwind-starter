{
    "name": "antlion/silverwind-starter",
    "description": "Start a Silverstripe CMS 6 site on the Silverwind theme (Tailwind CSS 4, daisyUI 5, Alpine.js) with its blocks, settings, site features and an optional demo",
    "type": "project",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/recipe-cms": "^6.0",
        "silverstripe/htmleditor-tinymce": "^1.0",
        "silverstripe/login-forms": "^6.0",
        "silverstripe/linkfield": "^5.0",
        "silverstripe/userforms": "^7.0",
        "silverstripe/mimevalidator": "^4.0",
        "dnadesign/silverstripe-elemental": "^6.0",
        "dnadesign/silverstripe-elemental-userforms": "^5.0",
        "dnadesign/silverstripe-setmenu": "^4.0",
        "nswdpc/silverstripe-elemental-image": "^2.0",
        "jonom/focuspoint": "^6.0",
        "plasticstudio/silverstripe-seo": "^6.0",
        "wilr/silverstripe-googlesitemaps": "^4.0",
        "innoweb/silverstripe-cookie-consent": "5.0.0",
        "cweagans/composer-patches": "^2.0",
        "antlion/silverwind": "dev-main",
        "antlion/silverwind-blocks": "dev-main as 1.0.x-dev",
        "antlion/silverwind-settings": "dev-main as 1.0.x-dev",
        "antlion/silverwind-site": "dev-main as 1.0.x-dev",
        "antlion/store-location": "2.x-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/marcd1983/silverwind.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/marcd1983/silverwind-blocks.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/marcd1983/silverwind-settings.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/marcd1983/silverwind-site.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/marcd1983/store-location.git"
        }
    ],
    "scripts": {
        "post-create-project-cmd": [
            "@php bin/setup.php"
        ],
        "post-install-cmd": [
            "@php bin/link-local-modules.php"
        ],
        "post-update-cmd": [
            "@php bin/link-local-modules.php"
        ]
    },
    "extra": {
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ],
        "patches": {
            "innoweb/silverstripe-cookie-consent": {
                "Fix invalid #[Override] attribute on CookiePolicyPageController::Form() (no parent method in SS 6.2+). Remove once upstream ships a fix.": "patches/cookie-consent-invalid-override-attribute.patch"
            }
        }
    },
    "config": {
        "process-timeout": 600,
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": true,
            "cweagans/composer-patches": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
